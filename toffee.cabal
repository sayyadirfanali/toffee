cabal-version:       >=1.10
-- Initial package description 'toffee.cabal' generated by 'cabal init'.
-- For further documentation, see http://haskell.org/cabal/users-guide/

name:                toffee
version:             0.1.0.0
-- synopsis:
-- description:
-- bug-reports:
-- license:
license-file:        LICENSE
author:              sayyadirfanali
maintainer:          irfan@irfanali.org
-- copyright:
-- category:
build-type:          Simple
extra-source-files:  CHANGELOG.md

library
  hs-source-dirs:      src
  exposed-modules:     Lexer, Parser, Expr, Stmnt, Utils
  build-depends:       base, mtl, containers, megaparsec, parser-combinators
  default-language:    Haskell2010

executable toffee
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:       base, mtl, containers, megaparsec, parser-combinators, toffee
  default-language:    Haskell2010

test-suite test
  type:                exitcode-stdio-1.0
  main-is:             Test.hs
  build-depends:       base, mtl, megaparsec, HUnit, toffee
  hs-source-dirs:      test
  default-language:    Haskell2010
