cabal-version: 2.2
name: toffee
version: 0.1.0.0
synopsis:
description:
bug-reports:
license:
license-file: LICENSE
author: sayyadirfanali
maintainer: irfan@irfanali.org
copyright:
category:
build-type: Simple
extra-source-files: CHANGELOG.md

common constraints
  default-extensions:
    LambdaCase
    PatternSynonyms
    OverloadedRecordDot
    ViewPatterns

library
  import: constraints
  hs-source-dirs: src
  exposed-modules:
    Expr
    Layout
    Lexer
    Parser
    -- Stmnt
    Utils
  build-depends:
    base,
    containers,
    megaparsec,
    mtl,
    parser-combinators
  default-language: Haskell2010

executable toffee
  import: constraints
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base,
    containers,
    megaparsec,
    mtl,
    parser-combinators,
    toffee
  default-language: Haskell2010

test-suite test
  import: constraints
  type: exitcode-stdio-1.0
  main-is: Test.hs
  other-modules:
    LayoutTests
    LexerTests
  build-depends:
    HUnit,
    base,
    megaparsec,
    mtl,
    toffee
  hs-source-dirs: test
  default-language: Haskell2010
