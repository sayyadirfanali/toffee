cabal-version: 2.2
name: toffee
version: 0.1.0.0
synopsis: A Haskell-flavoured front end for a JavaScript-like language
description: toffee lexes, applies Haskell-report-style layout, and parses ToffeeScript, a JavaScript-like expression language written with Haskell-style syntax (fn, where/do blocks).
license: GPL-3.0-only
license-file: LICENSE
author: sayyadirfanali
maintainer: irfan@irfanali.org
category: Language
build-type: Simple
extra-source-files: CHANGELOG.md

common constraints
  default-extensions:
    FlexibleInstances
    InstanceSigs
    LambdaCase
    OverloadedRecordDot
    PatternSynonyms
    ViewPatterns
  ghc-options: -Wall -Wno-unused-do-bind

library
  import: constraints
  hs-source-dirs: src
  exposed-modules:
    Expr
    Layout
    Lexer
    Parser
  build-depends:
    base,
    containers,
    megaparsec,
    parser-combinators
  default-language: Haskell2010

executable toffee
  import: constraints
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base,
    containers,
    megaparsec,
    parser-combinators,
    toffee
  default-language: Haskell2010

test-suite test
  import: constraints
  type: exitcode-stdio-1.0
  main-is: Test.hs
  other-modules:
    Render
    LayoutTests
    LexerTests
    ExprTests
  build-depends:
    HUnit,
    base,
    megaparsec,
    toffee
  hs-source-dirs: test
  default-language: Haskell2010

